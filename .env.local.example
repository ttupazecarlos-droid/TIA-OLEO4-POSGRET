# ============================================================
# TIA OLEO 4 - Variables de entorno para PostgreSQL LOCAL
# (Node.js + PostgreSQL instalado en la misma PC)
# Copia este archivo como .env
# ============================================================

APP_ENV=local
APP_DEBUG=1
PORT=3000
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tia_oleo4
DB_USER=postgres
DB_PASS=postgres
# En local PostgreSQL normalmente no usa SSL. En Supabase usa require.
DB_SSLMODE=disable
DB_POOL_MAX=10

SESSION_NAME=tiaoleo_sess
# Cambia este valor por uno propio:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# 0 porque el sitio local se abre por http://localhost
SESSION_SECURE=0
SESSION_MAX_AGE=86400

# Supabase Storage opcional (si esta vacio usa public/img)
# Usa la secret key nueva: sb_secret_...
# (SUPABASE_SERVICE_KEY solo para proyectos antiguos con clave eyJ...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=productos

# ------------------------------------------------------------
# Solo para migrar los datos de la version MySQL/MariaDB antigua
# (no hacen falta para que la tienda funcione)
# ------------------------------------------------------------
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DB=tia_oleo4
# MYSQL_USER=root
# MYSQL_PASS=
