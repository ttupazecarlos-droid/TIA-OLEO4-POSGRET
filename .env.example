# ============================================================
# TIA OLEO 4 - Variables de entorno
# Copia este archivo como .env y completa tus datos.
# En Railway/Render configura estas mismas variables en el panel.
# NUNCA subas .env a GitHub.
# ============================================================

APP_ENV=production
APP_DEBUG=0

# ------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection pooling
# Usa el "Session pooler" (puerto 5432). Evita el Transaction
# pooler (6543) porque no soporta sentencias preparadas.
# ------------------------------------------------------------
DB_HOST=aws-0-region-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.tuprojectref
DB_PASS=tu_password_de_supabase
DB_SSLMODE=require

# ------------------------------------------------------------
# Sesiones: db = guardadas en PostgreSQL (recomendado online)
#           file = archivos temporales del servidor
# ------------------------------------------------------------
SESSION_DRIVER=db
SESSION_NAME=tiaoleo_sess
# 1 cuando el sitio se sirve por HTTPS
SESSION_SECURE=1

# ------------------------------------------------------------
# Supabase Storage (opcional, recomendado en produccion)
# Storage -> New bucket -> nombre "productos" -> Public
# La service key SOLO se usa en el servidor.
# ------------------------------------------------------------
SUPABASE_URL=https://tuprojectref.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_o_sb_secret_key
SUPABASE_BUCKET=productos
