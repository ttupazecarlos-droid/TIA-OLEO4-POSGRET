# ============================================================
# TIA OLEO 4 - Variables de entorno (Node.js + PostgreSQL)
# Copia este archivo como .env y completa tus datos.
# En Render/Railway configura estas mismas variables.
# NUNCA subas .env a GitHub.
# ============================================================

APP_ENV=production
APP_DEBUG=0
PORT=3000
APP_URL=https://tu-dominio.com

# ------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection pooling
# Usa el "Session pooler" (puerto 5432). Evita el Transaction
# pooler (6543) porque no soporta sentencias preparadas.
# ------------------------------------------------------------
DB_HOST=aws-0-region-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.tuprojectref
DB_PASS=tu_password_de_supabase
DB_SSLMODE=require
DB_POOL_MAX=10

# ------------------------------------------------------------
# Sesiones: se guardan en la tabla PostgreSQL "sesiones"
# Genera un secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------
SESSION_NAME=tiaoleo_sess
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# 1 cuando el sitio se sirve por HTTPS
SESSION_SECURE=1
SESSION_MAX_AGE=86400

# ------------------------------------------------------------
# Supabase Storage (opcional, recomendado en produccion)
# Storage -> New bucket -> nombre "productos" -> Public
#
# Claves nuevas (noviembre 2025):
#   Settings -> API Keys -> Publishable and secret API keys
#   Copia la SECRET KEY: sb_secret_...
#   La publishable key NO se usa en este proyecto porque el backend
#   habla directo con PostgreSQL.
#
# La secret key SOLO se usa en el servidor. Si se deja vacia, las
# fotos se guardan en public/img.
#
# SUPABASE_SERVICE_KEY se mantiene como respaldo para proyectos
# antiguos que aun usan la service_role JWT (eyJ...).
# ------------------------------------------------------------
SUPABASE_URL=https://tuprojectref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta
# SUPABASE_SERVICE_KEY=eyJ... (solo proyectos antiguos)
SUPABASE_BUCKET=productos
